# ============================================================
# Aether Trader - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Frontend / Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Authentication
JWT_SECRET=your-secret-key-change-in-production

# Alpaca API
NEXT_PUBLIC_ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
NEXT_PUBLIC_ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Finnhub API
NEXT_PUBLIC_FINNHUB_API_KEY=your-finnhub-api-key

# Deployment
VERCEL_ENV=development

# ============================================================
# Backend - Aether Trading Platform
# ============================================================

# Application
AETHER_APP_NAME=Aether Trader
AETHER_DEBUG=false
AETHER_LOG_LEVEL=INFO

# Server
AETHER_HOST=0.0.0.0
AETHER_PORT=8000
AETHER_WORKERS=4

# Database (PostgreSQL)
AETHER_DATABASE_URL=postgresql://aether:aether_secret@localhost:5432/aether_trader
DATABASE_URL=postgresql://aether:aether_secret@localhost:5432/aether_trader
AETHER_DATABASE_POOL_SIZE=20

# Redis
AETHER_REDIS_URL=redis://localhost:6379/0
AETHER_REDIS_CACHE_TTL=300

# Trading Configuration
AETHER_INITIAL_CAPITAL=100000
AETHER_DEFAULT_COMMISSION=0.001
AETHER_DEFAULT_SLIPPAGE=0.0005
AETHER_DEFAULT_TIMEFRAME=1d

# Exchange (CCXT) - Paper Trading by Default
AETHER_EXCHANGE_ID=binance
AETHER_EXCHANGE_API_KEY=
AETHER_EXCHANGE_API_SECRET=
AETHER_EXCHANGE_SANDBOX=true

# AI / Reinforcement Learning
AETHER_RL_ALGORITHM=ppo
AETHER_RL_TOTAL_TIMESTEPS=100000
AETHER_RL_DEVICE=auto

# Genetic Optimizer
AETHER_GA_POPULATION_SIZE=100
AETHER_GA_GENERATIONS=50
AETHER_GA_MUTATION_RATE=0.1
AETHER_GA_CROSSOVER_RATE=0.8

# Risk Management
AETHER_MAX_POSITION_SIZE=0.10
AETHER_MAX_PORTFOLIO_LEVERAGE=1.0
AETHER_MAX_DAILY_LOSS=0.02
AETHER_MAX_DRAWDOWN=0.10
